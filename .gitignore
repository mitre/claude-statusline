/claude-statusline
/dist/
*.test
coverage.out
.DS_Store

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Local session recovery state (per-machine, never shared)
.beads/recovery-context.md
.beads/recovery-prompt.md
.beads/archive/

# Per-machine activity log — appended on every interaction, so tracking it
# produces a diff on every session and merge conflicts between machines.
.beads/interactions.jsonl

# GitHub App private keys must never be committed
*.pem
